# ==============================================================================
# ARQUIVO DE EXEMPLO DE VARIÁVEIS DE AMBIENTE (.env.example)
# Pipeline de 4 Serviços: Busca/Gestão -> Filtros -> Banco de Dados -> Compartilhamento
# NUNCA commite credenciais reais; copie para .env e preencha localmente.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. BANCO DE DADOS E CACHE (SERVIÇO 3 - INFRAESTRUTURA)
# ------------------------------------------------------------------------------
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=catalogo
POSTGRES_USER=postgres
POSTGRES_PASSWORD=<DEFINA_SENHA_FORTE_POSTGRES>

REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=<DEFINA_SENHA_REDIS_OU_VAZIO>

# ------------------------------------------------------------------------------
# 2. API DE GESTÃO E BUSCA DE PROMOÇÕES (SERVIÇO 1 - ESTE REPOSITÓRIO)
# ------------------------------------------------------------------------------
SERVER_PORT=8080
# Use vazio (padrão PostgreSQL) ou "local" para rodar com H2 em memória sem PostgreSQL
SPRING_PROFILES_ACTIVE=

DB_URL=jdbc:postgresql://localhost:5432/catalogo
DB_USERNAME=postgres
DB_PASSWORD=<DEFINA_SENHA_FORTE_POSTGRES>
JPA_DDL_AUTO=update

# Contrato de saída com a API de Filtros (Serviço 2)
FILTER_API_ENABLED=false
FILTER_API_BASE_URL=http://localhost:8081
FILTER_API_KEY=<CHAVE_INTERNA_COMPARTILHADA_BUSCA_FILTROS>
FILTER_API_CONNECT_TIMEOUT_MS=3000
FILTER_API_READ_TIMEOUT_MS=8000

# Resiliência global dos conectores, deduplicação e câmbio
INTEGRATION_CONNECT_TIMEOUT_MS=3000
INTEGRATION_READ_TIMEOUT_MS=8000
INTEGRATION_RETRY_MAX_ATTEMPTS=3
INTEGRATION_RETRY_INITIAL_DELAY_MS=300
INTEGRATION_CIRCUIT_FAILURE_THRESHOLD=5
INTEGRATION_CIRCUIT_OPEN_DURATION_SECONDS=60
INTEGRATION_DEDUP_TTL_MINUTES=360
CURRENCY_USD_BRL_RATE=5.75
AFFILIATE_CAMPAIGN_PREFIX=agy

# --- Varejista 1: Shopee Brasil (GraphQL Open API - Prioridade MVP 1) ---
RETAILER_SHOPEE_ENABLED=true
RETAILER_SHOPEE_SANDBOX_MODE=false
RETAILER_SHOPEE_API_URL=https://open-api.affiliate.shopee.com.br/graphql
RETAILER_SHOPEE_APP_ID=<SEU_SHOPEE_APP_ID>
RETAILER_SHOPEE_APP_SECRET=<SEU_SHOPEE_APP_SECRET>

# --- Varejista 2: AliExpress (AE-Affiliate Open Platform - Prioridade MVP 2) ---
RETAILER_ALIEXPRESS_ENABLED=true
RETAILER_ALIEXPRESS_SANDBOX_MODE=false
RETAILER_ALIEXPRESS_API_URL=https://api-sg.aliexpress.com/sync
RETAILER_ALIEXPRESS_APP_KEY=<SEU_ALIEXPRESS_APP_KEY>
RETAILER_ALIEXPRESS_APP_SECRET=<SEU_ALIEXPRESS_APP_SECRET>
RETAILER_ALIEXPRESS_TRACKING_ID=default

# --- Varejista 3: Mercado Livre Brasil (REST API MLB + Afiliados) ---
RETAILER_MERCADOLIVRE_ENABLED=false
RETAILER_MERCADOLIVRE_SANDBOX_MODE=false
RETAILER_MERCADOLIVRE_API_URL=https://api.mercadolibre.com
RETAILER_MERCADOLIVRE_CLIENT_ID=<SEU_ML_CLIENT_ID>
RETAILER_MERCADOLIVRE_CLIENT_SECRET=<SEU_ML_CLIENT_SECRET>
RETAILER_MERCADOLIVRE_ACCESS_TOKEN=<SEU_ML_ACCESS_TOKEN_OAUTH2>
RETAILER_MERCADOLIVRE_REFRESH_TOKEN=<SEU_ML_REFRESH_TOKEN_OAUTH2>
RETAILER_MERCADOLIVRE_AFFILIATE_TOOL=<SEU_MATT_TOOL_AFILIADO>
RETAILER_MERCADOLIVRE_AFFILIATE_WORD=<SEU_MATT_WORD_AFILIADO>

# --- Varejista 4: Amazon Brasil (Creators API OAuth 2.0) ---
RETAILER_AMAZON_ENABLED=false
RETAILER_AMAZON_SANDBOX_MODE=false
RETAILER_AMAZON_API_URL=https://affiliate-program.amazon.com/creatorsapi/v1
RETAILER_AMAZON_TOKEN_URL=https://api.amazon.com/auth/o2/token
RETAILER_AMAZON_CREDENTIAL_ID=<SEU_AMAZON_CREDENTIAL_ID>
RETAILER_AMAZON_CREDENTIAL_SECRET=<SEU_AMAZON_CREDENTIAL_SECRET>
RETAILER_AMAZON_PARTNER_TAG=<SUA_TAG_ASSOCIADO_EX_loja-20>
RETAILER_AMAZON_MARKETPLACE=www.amazon.com.br
RETAILER_AMAZON_MAX_TPS=1

# --- Rede Oficial Lomadee v3 (Magalu, KaBuM!, Casas Bahia, Americanas, Netshoes) ---
LOMADEE_API_URL=https://api.lomadee.com.br
LOMADEE_API_KEY=<SUA_CHAVE_X_API_KEY_LOMADEE>
LOMADEE_SOURCE_ID=<SEU_SOURCE_OU_CHANNEL_ID_LOMADEE>

RETAILER_MAGALU_ENABLED=false
RETAILER_MAGALU_SANDBOX_MODE=false
RETAILER_MAGALU_BRAND_ID=magazineluiza

RETAILER_KABUM_ENABLED=false
RETAILER_KABUM_SANDBOX_MODE=false
RETAILER_KABUM_BRAND_ID=kabum

RETAILER_CASASBAHIA_ENABLED=false
RETAILER_CASASBAHIA_SANDBOX_MODE=false
RETAILER_CASASBAHIA_BRAND_ID=casasbahia

RETAILER_AMERICANAS_ENABLED=false
RETAILER_AMERICANAS_SANDBOX_MODE=false
RETAILER_AMERICANAS_BRAND_ID=americanas

RETAILER_NETSHOES_ENABLED=false
RETAILER_NETSHOES_SANDBOX_MODE=false
RETAILER_NETSHOES_BRAND_ID=netshoes

# --- Rede Oficial Awin (Opcional / Product Feeds Complementares) ---
AWIN_API_URL=https://api.awin.com
AWIN_OAUTH_TOKEN=<SEU_AWIN_OAUTH2_BEARER_TOKEN>
AWIN_PUBLISHER_ID=<SEU_AWIN_PUBLISHER_ID>

# ------------------------------------------------------------------------------
# 3. API DE FILTROS (SERVIÇO 2 - PREMISSA ARQUITETURAL / OUTRO REPOSITÓRIO)
# ------------------------------------------------------------------------------
FILTER_SERVER_PORT=8081
FILTER_DB_URL=jdbc:postgresql://localhost:5432/catalogo
FILTER_INTERNAL_API_KEY=<CHAVE_INTERNA_COMPARTILHADA_BUSCA_FILTROS>
FILTER_MIN_REAL_DISCOUNT_PCT=15.0
FILTER_MIN_RATING=4.2
FILTER_MIN_STOCK=3
SHARE_API_BASE_URL=http://localhost:8082
SHARE_INTERNAL_API_KEY=<CHAVE_INTERNA_COMPARTILHADA_FILTROS_COMPARTILHAMENTO>

# ------------------------------------------------------------------------------
# 4. API DE COMPARTILHAMENTO (SERVIÇO 4 - PREMISSA ARQUITETURAL / OUTRO REPO)
# ------------------------------------------------------------------------------
SHARE_SERVER_PORT=8082
SHARE_DB_URL=jdbc:postgresql://localhost:5432/catalogo
SEARCH_API_BASE_URL=http://localhost:8080

# Canal Telegram Bot API (@BotFather)
TELEGRAM_ENABLED=false
TELEGRAM_BOT_TOKEN=<SEU_TELEGRAM_BOT_TOKEN>
TELEGRAM_CHAT_ID=<ID_DO_CANAL_OU_GRUPO_EX_-1001234567890>

# Canal WhatsApp Business Cloud API (Meta for Developers)
WHATSAPP_ENABLED=false
WHATSAPP_API_VERSION=v21.0
WHATSAPP_PHONE_NUMBER_ID=<SEU_WHATSAPP_PHONE_NUMBER_ID>
WHATSAPP_ACCESS_TOKEN=<SEU_META_SYSTEM_USER_ACCESS_TOKEN>
WHATSAPP_RECIPIENT_TARGET=<NUMERO_OU_LISTA_DESTINO>
